{
  "realpath": ["/usr/bin/realpath", "-e", "--"],
  "digest": ["/usr/bin/b2sum", "--"],
  "mountUuid": ["/usr/bin/findmnt", "-nro", "UUID"],
  "validateGrub": ["/usr/bin/grub-script-check"],
  "temporary": ["/usr/bin/mktemp"],
  "permissions": ["/usr/bin/chmod"],
  "copy": ["/usr/bin/cp", "--"],
  "directory": ["/usr/bin/mkdir", "-p", "--"],
  "identity": ["/usr/bin/id", "-u"],
  "fileMode": ["/usr/bin/stat", "--format=%f", "--"],
  "gsettings": ["/usr/bin/gsettings"],
  "wallpaperEntries": ["/usr/bin/find", "-L"],
  "move": ["/usr/bin/mv", "--"],
  "symbolicLink": ["/usr/bin/ln", "-s", "--"],
  "monitors": ["hyprctl", "monitors", "-j"],
  "renderWallpaper": ["/usr/bin/magick"],
  "runtimeFiles": ["/usr/bin/find"],
  "desktopDatabase": ["/usr/bin/update-desktop-database"],
  "repositoryFiles": ["/usr/bin/git"],
  "validateLua": ["/usr/bin/luac", "-p"],
  "removeDirectory": ["/usr/bin/rm", "-r", "--"],
  "processorCount": ["/usr/bin/getconf", "_NPROCESSORS_ONLN"],
  "userEnvironment": ["/usr/bin/systemctl", "--user", "set-environment"],
  "settingsDescriptions": ["/usr/bin/timeout", "10", "hyprctl", "descriptions", "-j"],
  "copyTree": ["/usr/bin/cp", "-a", "--"],
  "settingsValidate": ["/usr/bin/timeout", "20", "/usr/bin/env"],
  "settingsReload": ["/usr/bin/timeout", "10", "hyprctl", "reload", "config-only"],
  "settingsErrors": ["/usr/bin/timeout", "10", "hyprctl", "configerrors"],
  "settingsSerialized": ["/usr/bin/flock", "--exclusive", "--wait", "10"],
  "settingsQml": ["/usr/bin/env"]
}
