{
  "bootBuildStandalone": [
    "/usr/bin/grub-mkstandalone",
    "--format=x86_64-efi",
    "--locales=",
    "--fonts="
  ],
  "bootCandidateInspect": [
    "/usr/bin/objdump",
    "-h"
  ],
  "bootCheckGrubEFI": [
    "/usr/bin/grub-file",
    "--is-x86_64-efi"
  ],
  "bootCopy": [
    "/usr/bin/cp",
    "-r",
    "--preserve=timestamps",
    "--"
  ],
  "bootDevices": [
    "/usr/bin/lsblk",
    "--json",
    "--output",
    "NAME,TYPE,FSTYPE,UUID,PARTUUID,MOUNTPOINTS"
  ],
  "bootEspMount": [
    "/usr/bin/findmnt",
    "--json",
    "/boot"
  ],
  "bootExtractInitrd": [
    "/usr/bin/objcopy",
    "--dump-section"
  ],
  "bootFileInventory": [
    "/usr/bin/find",
    "/boot",
    "-maxdepth",
    "4",
    "-type",
    "f",
    "-printf",
    "%P\t%s\n"
  ],
  "bootFirmware": [
    "/usr/bin/efibootmgr"
  ],
  "bootFirmwareNext": [
    "/usr/bin/efibootmgr",
    "--bootnext"
  ],
  "bootFirmwareRestore": [
    "/usr/bin/efibootmgr",
    "--bootorder"
  ],
  "bootImageStrings": [
    "/usr/bin/strings"
  ],
  "bootListInitrd": [
    "/usr/bin/lsinitcpio",
    "-l"
  ],
  "bootPresets": [
    "/usr/bin/find"
  ],
  "bootRegenerate": [
    "/usr/bin/timeout",
    "900",
    "/usr/bin/limine-update"
  ],
  "bootRootMount": [
    "/usr/bin/findmnt",
    "--json",
    "/"
  ],
  "copy": [
    "/usr/bin/cp",
    "--"
  ],
  "copyTree": [
    "/usr/bin/cp",
    "-a",
    "--"
  ],
  "desktopDatabase": [
    "/usr/bin/update-desktop-database"
  ],
  "digest": [
    "/usr/bin/b2sum",
    "--"
  ],
  "directory": [
    "/usr/bin/mkdir",
    "-p",
    "--"
  ],
  "environment": [
    "/usr/bin/env"
  ],
  "fileMode": [
    "/usr/bin/stat",
    "--format=%f",
    "--"
  ],
  "gsettings": [
    "/usr/bin/gsettings"
  ],
  "identity": [
    "/usr/bin/id",
    "-u"
  ],
  "isDirectory": [
    "/usr/bin/test",
    "-d"
  ],
  "isExecutable": [
    "/usr/bin/test",
    "-x"
  ],
  "isLink": [
    "/usr/bin/test",
    "-L"
  ],
  "isSocket": [
    "/usr/bin/test",
    "-S"
  ],
  "monitors": [
    "hyprctl",
    "monitors",
    "-j"
  ],
  "mountUuid": [
    "/usr/bin/findmnt",
    "-nro",
    "UUID"
  ],
  "move": [
    "/usr/bin/mv",
    "--"
  ],
  "permissions": [
    "/usr/bin/chmod"
  ],
  "processorCount": [
    "/usr/bin/getconf",
    "_NPROCESSORS_ONLN"
  ],
  "readLink": [
    "/usr/bin/readlink",
    "--"
  ],
  "realpath": [
    "/usr/bin/realpath",
    "-e",
    "--"
  ],
  "removeDirectory": [
    "/usr/bin/rm",
    "-r",
    "--"
  ],
  "renderWallpaper": [
    "/usr/bin/magick"
  ],
  "repositoryFiles": [
    "/usr/bin/git"
  ],
  "runtimeFiles": [
    "/usr/bin/find"
  ],
  "settingsDescriptions": [
    "/usr/bin/timeout",
    "10",
    "hyprctl",
    "descriptions",
    "-j"
  ],
  "settingsErrors": [
    "/usr/bin/timeout",
    "10",
    "hyprctl",
    "configerrors"
  ],
  "settingsQml": [
    "/usr/bin/env"
  ],
  "settingsReload": [
    "/usr/bin/timeout",
    "10",
    "hyprctl",
    "reload",
    "config-only"
  ],
  "settingsSerialized": [
    "/usr/bin/flock",
    "--exclusive",
    "--wait",
    "10"
  ],
  "settingsValidate": [
    "/usr/bin/timeout",
    "20",
    "/usr/bin/env"
  ],
  "symbolicLink": [
    "/usr/bin/ln",
    "-s",
    "--"
  ],
  "temporary": [
    "/usr/bin/mktemp"
  ],
  "userEnvironment": [
    "/usr/bin/systemctl",
    "--user",
    "set-environment"
  ],
  "validateGrub": [
    "/usr/bin/grub-script-check"
  ],
  "validateLua": [
    "/usr/bin/luac",
    "-p"
  ],
  "wallpaperEntries": [
    "/usr/bin/find",
    "-L"
  ]
}
