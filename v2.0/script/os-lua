#!/usr/bin/env bash
set -euo pipefail
entry=$(readlink -f -- "${BASH_SOURCE[0]}")
root=$(cd -- "${entry%/*}/.." && pwd -P)
name=${0##*/}
if [[ "$name" == "os-grub-menu" || "$name" == "99-os-grub-menu" ]]; then
    set -- publish-grub "$@"
fi
interpreter=
while IFS='=' read -r key value; do
    case "$key" in
        COMMAND_PATH) export PATH="$value" ;;
        INTERPRETER) interpreter="$value" ;;
        *) exit 1 ;;
    esac
done < "$root/data/core/bootstrap.env"
[[ "$interpreter" == /* && -x "$interpreter" ]]
exec "$interpreter" -E "$root/src/main.lua" "$root" "$@"
