{
  "browser": {
    "selector": "browser",
    "fallbackMime": "x-scheme-handler/https",
    "privateAction": "new-private-window"
  },
  "editor": {
    "selector": "mime",
    "mime": "text/plain"
  },
  "files": {
    "selector": "mime",
    "mime": "inode/directory"
  },
  "settings": {
    "selector": "desktop",
    "desktop": "os.settings.desktop"
  },
  "calendar": {
    "selector": "desktop",
    "desktop": "org.gnome.Calendar.desktop"
  },
  "weather": {
    "selector": "desktop",
    "desktop": "org.gnome.Weather.desktop"
  },
  "clock": {
    "selector": "desktop",
    "desktop": "org.gnome.clocks.desktop"
  },
  "audio": {
    "selector": "desktop",
    "desktop": "os.settings.desktop"
  },
  "network": {
    "selector": "desktop",
    "desktop": "os.settings.desktop"
  },
  "bluetooth": {
    "selector": "desktop",
    "desktop": "os.settings.desktop"
  },
  "resources": {
    "selector": "desktop",
    "desktop": "net.nokyan.Resources.desktop"
  },
  "media": {
    "selector": "desktop",
    "desktop": "io.github.celluloid_player.Celluloid.desktop"
  }
}
