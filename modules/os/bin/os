#!/usr/bin/env bash
set -euo pipefail

OS_BIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
OS_CANDIDATES=()
if [[ -n "${OS_CHANGELOG:-}" ]]; then
    OS_CANDIDATES+=("$OS_CHANGELOG")
fi
OS_CANDIDATES+=("$OS_BIN_DIR/../../../CHANGELOG.md" "/usr/share/os/CHANGELOG.md" "$HOME/.local/share/os/CHANGELOG.md")

os_msg() {
    if [[ "${OS_I18N_FALLBACK:-1}" -eq 0 ]] && command -v t >/dev/null 2>&1; then
        t "$@" 2>/dev/null && return 0
    fi
    case "${1:-}" in
        os.runtime_missing) printf '%s\n' "omarchy runtime is required for this command" ;;
        os.dispatch_failed) printf '%s\n' "os could not dispatch ${2:-unknown}" ;;
        os.changelog_missing) printf '%s\n' "changelog is unavailable at ${2:-unknown location}" ;;
        os.changelog_unknown) printf '%s\n' "unknown release ${2:-unknown}" ;;
        *) printf '%s\n' "${1:-os error}" ;;
    esac
}

os_err() {
    printf '%s\n' "error: $(os_msg "$@")" >&2
}

os_usage() {
    cat << 'USAGE'
os - hardened Omarchy command dispatcher

Usage:
  os <group> <command> [args...]
  os commands [--all] [--json] [--check]
  os changelog [release]
  os version
  os --help

Behavior:
  os prepares OMARCHY_PATH with the session runtime and message bus
  and forwards every group command to the native omarchy entrypoint.
USAGE
}

os_lib_init() {
    local lib=""
    for lib in "$OS_BIN_DIR/../../../scripts/lib/i18n.sh" "/usr/share/os/lib/i18n.sh"; do
        if [[ -f "$lib" ]]; then
            # shellcheck source=/dev/null
            source "$lib" 2>/dev/null || return 1
            if command -v i18n_init >/dev/null 2>&1; then
                i18n_init 2>/dev/null || return 1
            fi
            return 0
        fi
    done
    return 1
}

OS_I18N_FALLBACK=0
if ! os_lib_init 2>/dev/null; then
    OS_I18N_FALLBACK=1
fi

os_resolve_runtime() {
    if [[ -z "${OMARCHY_PATH:-}" ]]; then
        if [[ -f /usr/share/omarchy/default/bash/env-bootstrap ]]; then
            # shellcheck source=/dev/null
            source /usr/share/omarchy/default/bash/env-bootstrap 2>/dev/null || OMARCHY_PATH="/usr/share/omarchy"
        fi
        OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
        export OMARCHY_PATH
    fi
    local uid=""
    uid="$(id -u 2>/dev/null || printf '')"
    if [[ -z "${XDG_RUNTIME_DIR:-}" && -n "$uid" && -d "/run/user/$uid" ]]; then
        export XDG_RUNTIME_DIR="/run/user/$uid"
    fi
    if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && -n "$uid" && -S "/run/user/$uid/bus" ]]; then
        export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus"
    fi
}

os_find_changelog() {
    local candidate=""
    for candidate in "${OS_CANDIDATES[@]}"; do
        if [[ -f "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

os_changelog() {
    local file=""
    file="$(os_find_changelog)" || { os_err "os.changelog_missing" "${OS_CANDIDATES[0]}"; return 1; }
    if [[ $# -eq 0 ]]; then
        cat "$file"
        return 0
    fi
    local want="$1"
    [[ "$want" != v* ]] && want="v$want"
    local printed=""
    printed="$(awk -v tag="## Release $want" '$0 == tag { show = 1; print; next } show && /^## Release / { exit } show { print }' "$file")"
    if [[ -z "$printed" ]]; then
        os_err "os.changelog_unknown" "$want"
        return 1
    fi
    printf '%s\n' "$printed"
}

os_version() {
    local over=""
    over="$(cat /usr/share/omarchy/version 2>/dev/null || printf 'unknown')"
    local och=""
    och="$(omarchy version 2>/dev/null || printf 'unknown')"
    printf '%s\n' "os dispatcher 1.0.0"
    printf '%s\n' "omarchy $och"
    printf '%s\n' "omarchy version file $over"
}

os_main() {
    if [[ $# -eq 0 ]]; then
        os_usage >&2
        os_err "os.dispatch_failed" "missing command"
        return 1
    fi
    case "${1:-}" in
        -h|--help|help)
            os_usage
            return 0
            ;;
        changelog)
            shift
            os_changelog "$@"
            return $?
            ;;
        version|--version)
            os_resolve_runtime
            command -v omarchy >/dev/null || { os_err "os.runtime_missing"; return 1; }
            os_version
            return 0
            ;;
    esac
    os_resolve_runtime
    command -v omarchy >/dev/null || { os_err "os.runtime_missing"; return 1; }
    exec omarchy "$@"
}

os_main "$@"
