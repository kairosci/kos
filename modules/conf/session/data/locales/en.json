  "patterns": [
    {
      "match": "^No matches for “(.*)”$",
      "value": "No matches for “$1”"
    },
    {
      "match": "^Do you want to uninstall (.*)\\?$",
      "value": "Do you want to uninstall $1?"
    },
    {
      "match": "^Queue \\((.*)\\)$",
      "value": "Queue ($1)"
    },
    {
      "match": "^Sources \\((.*)\\)$",
      "value": "Sources ($1)"
    },
    {
      "match": "^UPCOMING QUEUE \\((.*)\\)$",
      "value": "UPCOMING QUEUE ($1)"
    },
    {
      "match": "^Start weeks on (.*)$",
      "value": "Start weeks on $1"
    },
    {
      "match": "^Stay on (.*)$",
      "value": "Stay on $1"
    },
    {
      "match": "^(.*) · focused$",
      "value": "$1 · focused"
    }
  ]
}
