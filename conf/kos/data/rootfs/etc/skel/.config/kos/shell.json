{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "kos.clock",
    "layout": {
      "left": [
        {
          "id": "kos.menu"
        },
        {
          "id": "kos.workspaces"
        }
      ],
      "center": [
        {
          "id": "kos.indicators"
        },
        {
          "id": "kos.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        },
        {
          "id": "kos.keyboard-layout"
        },
        {
          "id": "kos.weather"
        },
        {
          "id": "kos.system-update"
        }
      ],
      "right": [
        {
          "id": "kos.tray"
        },
        {
          "id": "kos.agents"
        },
        {
          "id": "kos.bluetooth"
        },
        {
          "id": "kos.network"
        },
        {
          "id": "kos.audio"
        },
        {
          "id": "kos.monitor"
        },
        {
          "id": "kos.power"
        }
      ]
    }
  },
  "plugins": []
}
