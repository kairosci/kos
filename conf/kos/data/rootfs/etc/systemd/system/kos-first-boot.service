[Unit]
Description=kos first boot provisioning
Wants=network-online.target
After=network-online.target
Before=display-manager.service
ConditionPathExists=!/var/lib/kos/provisioned

[Service]
Type=oneshot
EnvironmentFile=/etc/kos/install.conf
ExecStart=/usr/bin/bash /usr/share/kos/provision/scripts/setup.sh
ExecStartPost=/usr/bin/install -Dm600 /dev/null /var/lib/kos/provisioned
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
