#!/bin/bash

# kos:summary=Remove the xpadneo Xbox controller driver and undo its module/blacklist config.
# kos:group=remove
# kos:name=gaming xbox-controllers
# kos:requires-sudo=true

set -e

kos-pkg-drop xpadneo-dkms

sudo rm -f /etc/modprobe.d/blacklist-xpad.conf /etc/modules-load.d/xpadneo.conf

echo ""
echo "Xbox controller support removed. Reboot to fully unload xpadneo and restore xpad."
