#!/bin/bash

# kos:summary=Reinstall all default Kos packages from the stable channel
# kos:requires-sudo=true

set -e

# Reinstall all default Kos packages from the stable channel and downgrade any packages that are too new.

# Set the package repository to the stable mirrors
kos-refresh-pacman

# Downgrade any packages to the stable setup
sudo env KOS_UPDATE_PACMAN=1 pacman -Suu --noconfirm

# Ensure all packages are installed
mapfile -t packages < <(grep -v '^#' "$KOS_PATH/install/kos-base.packages" | grep -v '^$')
sudo env KOS_UPDATE_PACMAN=1 pacman -Syu --noconfirm --needed "${packages[@]}"
