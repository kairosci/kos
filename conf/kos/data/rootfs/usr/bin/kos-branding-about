#!/bin/bash

# kos:summary=Edit, set, or reset About branding
# kos:group=branding
# kos:name=about
# kos:args=<image|text|reset>
# kos:examples=kos branding about image | kos branding about text | kos branding about reset

set -euo pipefail

case "${1:-}" in
image)
  image=$(kos-file-select --title "Pick PNG or SVG for About" --extensions "png svg")
  if kos-transcode-ascii "$image" ~/.config/kos/branding/about.txt --width 54 --height 26; then
    kos-launch-about >/dev/null 2>&1
  fi
  ;;
text)
  kos-launch-editor ~/.config/kos/branding/about.txt >/dev/null 2>&1 && kos-launch-about >/dev/null 2>&1
  ;;
reset)
  cp "$KOS_PATH/icon.txt" ~/.config/kos/branding/about.txt && kos-launch-about >/dev/null 2>&1
  ;;
*)
  echo "Usage: kos-branding-about <image|text|reset>" >&2
  exit 1
  ;;
esac
