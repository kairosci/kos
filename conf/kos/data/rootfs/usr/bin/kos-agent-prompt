#!/bin/bash

# kos:summary=Launch the default coding agent with a prompt
# kos:args=[--inline] <prompt...>
# kos:examples=kos agent prompt "Review this project"

# Prompts live here rather than on `kos agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

inline=()
if [[ ${1:-} == "--inline" ]]; then
  inline=(--inline)
  shift
fi

if (($# == 0)); then
  echo "Usage: kos agent prompt [--inline] <prompt...>" >&2
  exit 1
fi

exec kos-agent "${inline[@]}" --prompt "$*"
