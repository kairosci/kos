#!/bin/bash

# kos:summary=Launch or focus on a given web app identified by the window-pattern.
# kos:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: kos-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
LAUNCH_COMMAND="kos-launch-webapp $@"

exec kos-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
