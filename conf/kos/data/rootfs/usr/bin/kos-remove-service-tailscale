#!/bin/bash

# kos:summary=Remove Tailscale and its bar plugin.
# kos:requires-sudo=true

tailscale down 2>/dev/null || true
systemctl --user disable --now kos-tailscale-receive.service 2>/dev/null || true
sudo systemctl disable --now tailscaled.service 2>/dev/null || true
kos-plugin-disable kos.tailscale
kos-webapp-remove "Tailscale" 2>/dev/null || true
kos-pkg-drop tailscale

echo ""
echo "Tailscale has been removed."
