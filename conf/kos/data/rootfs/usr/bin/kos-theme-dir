#!/bin/bash

# kos:summary=Print the directory holding a theme, preferring a user-installed copy
# kos:args=<theme-name>
# kos:examples=kos theme dir tokyo-night

theme="${1:-}"

if [[ -z $theme ]]; then
  echo "Usage: kos-theme-dir <theme-name>" >&2
  exit 1
fi

if [[ -d $HOME/.config/kos/themes/$theme ]]; then
  echo "$HOME/.config/kos/themes/$theme"
else
  echo "$KOS_PATH/themes/$theme"
fi
