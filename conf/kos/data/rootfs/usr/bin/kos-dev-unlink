#!/bin/bash

# kos:summary=Restore Kos to the package install after reboot
# kos:group=dev
# kos:args=[--no-reboot]

set -euo pipefail

if (( EUID == 0 )); then
  echo "Error: run kos-dev-unlink as your user, not under sudo." >&2
  exit 1
fi

prompt_reboot=1

sudoers_file="/etc/sudoers.d/kos-dev-path"

if (( $# > 1 )); then
  echo "Usage: kos dev unlink [--no-reboot]" >&2
  exit 1
fi

case "${1:-}" in
  "")
    ;;
  --no-reboot)
    prompt_reboot=0
    ;;
  -h|--help)
    cat <<USAGE
Usage: kos dev unlink [--no-reboot]

Writes /etc/kos.conf so KOS_PATH resolves to /usr/share/kos
after reboot. This intentionally does not rewrite the running Hyprland,
systemd, shell, or app-launcher environment; reboot to make every layer agree.

Removes $sudoers_file, the drop-in that pointed sudo
at the checkout, so sudo goes back to the packaged kos-* immediately.

Use --no-reboot when another command will handle the reboot prompt.
USAGE
    exit 0
    ;;
  *)
    echo "Usage: kos dev unlink [--no-reboot]" >&2
    exit 1
    ;;
esac

default_target="/usr/share/kos"

printf 'export KOS_PATH="%s"\n' "$default_target" | sudo tee /etc/kos.conf >/dev/null

# kos-dev-link prepended the checkout to sudo's secure_path. Drop it in the
# same step that drops the checkout, or sudo keeps running a tree nothing else
# points at — and keeps trusting a user-writable directory for root's commands.
sudo rm -f "$sudoers_file"

echo "Pointed Kos at $default_target"
echo

if (( prompt_reboot )) && gum confirm "Reboot now to activate?"; then
  kos-system-reboot
fi
