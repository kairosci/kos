#!/bin/bash

# kos:summary=Update Kos and system packages
# kos:args=[-y]
# kos:examples=kos update | kos update -y
# kos:requires-sudo=true

set -e

if [[ -z ${KOS_UPDATE_LOGGED:-} ]]; then
  script_command=$(printf '%q ' "$0" "$@")
  exec env KOS_UPDATE_LOGGED=1 script -qefc "$script_command" "/tmp/kos-update.log"
fi

if ! kos-update-lock held; then
  exec kos-update-lock run "$0" "$@"
fi

trap 'echo ""; echo -e "\033[0;31mSomething went wrong during the update!\n\nPlease review the output above carefully, correct the error, and retry the update.\n\nIf you need assistance, get help from the community at https://github.com/kairosci/kos/issues\033[0m"' ERR
trap 'kos-update-stay-awake stop' EXIT

kos-update-requires-free-space

# -y is a promise not to ask anything. Steps that would need an answer report
# and move on instead of waiting on a prompt nobody is here to give.
[[ ${1:-} != "-y" ]] || export KOS_UPDATE_UNATTENDED=1

if [[ ${1:-} == "-y" ]] || kos-update-confirm; then
  # Before the snapshot: the cache is on the snapshotted subvolume, so pruning
  # after it frees nothing until that snapshot ages out.
  kos-update-pkg-prune

  # 127 means Snapper is deliberately absent. Any other failure already said
  # what went wrong, and a missing snapshot is not worth blocking an update
  # over, but it must not pass for one either.
  kos-snapshot create || (($? == 127)) ||
    echo -e "\e[33mContinuing the update without a snapshot.\e[0m" >&2

  kos-update-stay-awake start

  kos-update-dev
  kos-update-release

  # Migrations ship with the packages installed here and are written against
  # them, so everything below waits on this finishing. An upgrade that stopped
  # takes the update with it rather than migrating against what is still on disk.
  kos-update-system-pkgs
  kos-migrate
  kos-hook post-update
  kos-update-aur-pkgs
  kos-update-mise
  kos-update-orphan-pkgs

  kos-update-analyze-logs
  kos-update-status

  # Release update-owned inhibitors before offering a reboot. A confirmed
  # reboot can terminate this process before its EXIT trap gets a chance to
  # remove the persistent Stay Awake marker.
  kos-update-stay-awake stop
  trap - EXIT

  kos-update-restart
fi
