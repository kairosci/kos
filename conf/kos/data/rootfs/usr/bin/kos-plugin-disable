#!/bin/bash

# kos:summary=Disable a shell plugin
# kos:group=plugin
# kos:args=<id>

set -euo pipefail

fail() {
  echo "kos-plugin-disable: $*" >&2
  exit 1
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  echo "Usage: kos plugin disable <id>"
  exit 0
fi

id="${1:-}"
[[ -n $id ]] || fail "plugin id is required"

result=$(kos-shell shell setPluginEnabled "$id" false)
[[ $result == "ok" ]] ||
  fail "plugin '$id' is not known; run: kos-shell shell rescanPlugins"

echo "Disabled $id"
