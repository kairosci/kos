#!/bin/bash

# kos:summary=Select and set the system timezone
# kos:group=menu
# kos:name=timezone

set -e

timezone=$(timedatectl list-timezones | kos-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
kos-shell -q kos.clock refresh
kos-notification-send "Timezone is now set to $timezone"
