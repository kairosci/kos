#!/bin/bash

# kos:summary=Reinstall Kos packages and reset default configs
# kos:requires-sudo=true

set -e

echo -e "This will reinstall all default Kos packages and reset default configs.\nWarning: user config changes will be overwritten.\n"

if gum confirm "Are you sure you want to reinstall and lose config changes?"; then
  kos-reinstall-pkgs
  kos-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && kos-system-reboot
fi
