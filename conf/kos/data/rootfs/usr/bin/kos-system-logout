#!/bin/bash

# kos:summary=Log out after closing application windows
# kos:examples=kos logout | kos system logout
# kos:aliases=kos logout

nohup bash -c "sleep 2 && uwsm stop" >/dev/null 2>&1 &

kos-osd -i logout -m "Logging out" -d 5000

# Now close all windows
kos-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
