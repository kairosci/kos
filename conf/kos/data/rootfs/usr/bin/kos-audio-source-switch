#!/bin/bash

# kos:summary=Cycle to the next media source and transfer playback when the current source is playing
# kos:args=[next|previous]
# kos:examples=kos audio source switch | kos-audio-source-switch previous

direction="${1:-next}"

case "$direction" in
  next)
    kos-shell media sourceSwitch
    ;;
  previous)
    kos-shell media sourceSwitchPrevious
    ;;
  *)
    echo "Usage: kos-audio-source-switch [next|previous]" >&2
    exit 1
    ;;
esac
