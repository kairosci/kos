#!/bin/bash

# kos:summary=Update the active Kos dev checkout

set -euo pipefail

[[ $KOS_PATH != "/usr/share/kos" ]] || exit 0

if ! git -C "$KOS_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: KOS_PATH is not a git checkout: $KOS_PATH" >&2
  exit 1
fi

upstream=$(git -C "$KOS_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [[ -z $upstream ]]; then
  echo -e "\e[33m\nSkip Kos dev checkout update (current branch has no upstream)\e[0m"
  exit 0
fi

echo -e "\e[32m\nUpdate Kos dev checkout\e[0m"
git -C "$KOS_PATH" pull --ff-only
