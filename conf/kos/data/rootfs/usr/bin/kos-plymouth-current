#!/bin/bash

# kos:summary=Show which theme is styling the Plymouth boot screen
# kos:examples=kos plymouth current

# kos-plymouth-set installs the theme's unlock.png as a byte-for-byte
# copy of logo.png, so matching it back identifies the current theme.
installed_logo=/usr/share/plymouth/themes/kos/logo.png

if cmp -s "$KOS_PATH/default/plymouth/logo.png" "$installed_logo"; then
  echo default
  exit
fi

kos-plymouth-list | while read -r name; do
  if cmp -s "$(kos-theme-dir "$name")/unlock.png" "$installed_logo"; then
    echo "$name"
    exit
  fi
done
