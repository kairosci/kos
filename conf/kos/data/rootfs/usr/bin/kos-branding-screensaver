#!/bin/bash

# kos:summary=Edit, set, or reset screensaver branding
# kos:group=branding
# kos:name=screensaver
# kos:args=<image|text|reset>
# kos:examples=kos branding screensaver image | kos branding screensaver text | kos branding screensaver reset

set -euo pipefail

case "${1:-}" in
image)
  image=$(kos-file-select --title "Pick PNG or SVG for screensaver" --extensions "png svg")
  if kos-transcode-ascii "$image" ~/.config/kos/branding/screensaver.txt; then
    kos-launch-screensaver force >/dev/null 2>&1
  fi
  ;;
text)
  kos-launch-editor ~/.config/kos/branding/screensaver.txt >/dev/null 2>&1 && kos-launch-screensaver force >/dev/null 2>&1
  ;;
reset)
  cp "$KOS_PATH/logo.txt" ~/.config/kos/branding/screensaver.txt && kos-launch-screensaver force >/dev/null 2>&1
  ;;
*)
  echo "Usage: kos-branding-screensaver <image|text|reset>" >&2
  exit 1
  ;;
esac
