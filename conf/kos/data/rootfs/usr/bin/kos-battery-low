#!/bin/bash

# kos:summary=Send the low battery warning notification and run battery-low hooks.
# kos:args=<percentage>
# kos:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: kos-battery-low <percentage>" >&2
  exit 1
fi

level=$1

kos-notification-send -g 󱐋 -u critical "Time to recharge!" "Battery is down to ${level}%" -i battery-caution -t 30000
kos-hook battery-low "$level"
