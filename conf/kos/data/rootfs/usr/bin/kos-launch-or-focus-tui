#!/bin/bash

# kos:summary=Launch a TUI or focus an existing terminal window for it
# kos:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.kos.$(basename "$1")"
fi

LAUNCH_COMMAND="kos-launch-tui $@"

exec kos-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
