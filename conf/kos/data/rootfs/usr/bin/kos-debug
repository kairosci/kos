#!/usr/bin/env bash
# kos:summary=Print local system diagnostics
# kos:args=[--no-sudo] [--print]
set -euo pipefail
source "${KOS_LIB_PATH:-${KOS_PATH:-/usr/share/kos}/lib}/i18n.sh"
i18n_init
for argument in "$@"; do
    case $argument in --no-sudo|--print) ;; *) err release.invalid ;; esac
done
kos-version
uname -a
pacman -Q
systemctl --failed --no-pager
