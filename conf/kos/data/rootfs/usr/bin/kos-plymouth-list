#!/bin/bash

# kos:summary=List themes that can style the Plymouth boot screen
# kos:examples=kos plymouth list

{
  find ~/.config/kos/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n' 2>/dev/null
  find "$KOS_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | while read -r name; do
  if [[ -f $(kos-theme-dir "$name")/preview-unlock.png ]]; then
    echo "$name"
  fi
done
