#!/bin/bash

# kos:summary=Install Heroic Games Launcher (Epic, GOG, Amazon Prime Gaming) with graphics drivers.
# kos:requires-sudo=true

set -e

echo "Installing Heroic Games Launcher..."
kos-pkg-add heroic-games-launcher-bin
kos-install-gaming-gpu-lib32

setsid uwsm-app -- gtk-launch heroic >/dev/null 2>&1 &
