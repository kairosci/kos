#!/bin/bash

# kos:summary=Overwrite the user config for the Plymouth drive decryption and boot sequence with the Kos default and rebuild it.
# kos:requires-sudo=true

# Reuse the fixed-file publisher so root never resolves the source checkout or
# follows a destination symlink while restoring the packaged assets.
exec "$KOS_PATH/bin/kos-plymouth-set" --refresh-default
