#!/bin/bash

# kos:summary=Apply Kos system setup in the installed target
# kos:group=apply
# kos:requires-sudo=true
# kos:examples=kos apply system --install-user dhh --first-install
# kos:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: kos apply system --install-user USER [--first-install|--upgrade]
       kos apply system --defer-provisioning --first-install

Runs root-owned Kos system setup. The ISO calls this in the target chroot
after packages are installed and the target user exists. It also calls
kos-apply-hardware, so hardware setup cannot be accidentally skipped.

--defer-provisioning runs without an install user: deferred-provisioning installs create the user at
first boot, so scripts that grant group memberships record them in
/var/lib/kos/provisioning/groups instead of calling usermod.
USAGE
}

install_user="${KOS_INSTALL_USER:-}"
first_install=0
upgrade=0
defer_provisioning=0

while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    --first-install)
      first_install=1
      shift
      ;;
    --upgrade)
      upgrade=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: kos-apply-system must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export KOS_INSTALL_USER="$install_user"
export KOS_FIRST_INSTALL="$first_install"
export KOS_UPGRADE="$upgrade"
export KOS_PATH="${KOS_PATH:-/usr/share/kos}"
export KOS_INSTALL="${KOS_INSTALL:-$KOS_PATH/install}"
export KOS_INSTALL_LOG_FILE="${KOS_INSTALL_LOG_FILE:-/var/log/kos-install.log}"
export PATH="$KOS_PATH/bin:$PATH"

source "$KOS_INSTALL/helpers/logging.sh"
start_install_log

source "$KOS_INSTALL/config/all.sh"

if (( defer_provisioning )); then
  kos-apply-hardware --defer-provisioning
else
  kos-apply-hardware --install-user "$install_user"
fi

source "$KOS_INSTALL/login/all.sh"
source "$KOS_INSTALL/post-install/all.sh"

stop_install_log
