#!/bin/bash

# kos:summary=Install Steam and graphics drivers selected for this system
# kos:requires-sudo=true

set -e

echo "Installing Steam..."
kos-pkg-add steam
kos-install-gaming-gpu-lib32

echo ""
echo "Steam will start automatically now. This might take a while..."

setsid uwsm-app -- gtk-launch steam >/dev/null 2>&1 &
