#!/bin/bash

# kos:summary=Print the active Kos dev-link git branch
# kos:hidden=true

kos_path=${KOS_PATH:-/usr/share/kos}
kos_path=${kos_path%/}

[[ $kos_path != "/usr/share/kos" ]] || exit 1

branch=$(git -C "$kos_path" branch --show-current 2>/dev/null || true)
if [[ -z $branch ]]; then
  hash=$(git -C "$kos_path" rev-parse --short HEAD 2>/dev/null || true)
  [[ -n $hash ]] || exit 1
  branch="detached@$hash"
fi

echo "$branch"
