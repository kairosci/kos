#!/usr/bin/env bash

build() {
	add_module btrfs
	add_module overlay
	add_binary btrfs
	add_binary echo
	add_binary findmnt
	add_binary mktemp
	add_binary mount
	add_binary mkdir
	add_runscript
}

help() {
	cat <<HELPEOF
This hook uses overlayfs to boot on a read only snapshot.
HELPEOF
}

