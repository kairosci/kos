# Single source of truth for KOS_PATH + PATH adjustments. Sourced by:
#   /etc/profile.d/kos.sh                 (system login shells)
#   /etc/skel/.bashrc                         (interactive shells)
#   /usr/share/uwsm/env.d/10-kos          (Hyprland session via uwsm)
#   /usr/share/kos/default/bash/envs      (bash rc chain; SSH/non-login)

# /etc/kos.conf is written by kos-dev-link and reset by
# kos-dev-unlink. When absent, force the packaged default instead of
# preserving a stale inherited value.
if [ -f /etc/kos.conf ]; then
  . /etc/kos.conf
  : "${KOS_PATH:=/usr/share/kos}"
else
  KOS_PATH=/usr/share/kos
fi
export KOS_PATH

# Only prepend in dev-link mode. On a production install, the binaries are
# already on PATH as /usr/bin/kos-* via the kos package — prepending
# /usr/share/kos/bin would just be noise.
if [ "$KOS_PATH" != /usr/share/kos ]; then
  case ":$PATH:" in
    *":${KOS_PATH%/}/bin:"*) ;;
    *) PATH="${KOS_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
fi

# User-level tool paths, appended so system binaries keep precedence. This is
# what lets login shells (ssh, bash -lc) and the uwsm session find mise-managed
# tools without an interactive rc. Keep these directories in sync with the PAM
# PATH line from install/config/ssh-command-path.sh, which covers SSH commands
# that run no shell setup at all.
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/share/mise/shims" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/bin" ;;
esac
export PATH
