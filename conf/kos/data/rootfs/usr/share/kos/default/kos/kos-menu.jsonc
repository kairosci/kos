{
  // Kos menu definition.
  // JSONC is used for Neovim-friendly highlighting, comments, and trailing commas.
  // IDs are object keys. Dotted IDs imply hierarchy: trigger.share.file belongs
  // under trigger.share.
  // Kind is inferred: action -> action, target -> link, otherwise submenu.
  // Dotted IDs define the tree. Use provider:"name" only when the submenu
  // calls provider_name() or a command named "name" to return JSON rows.
  // Optional fields:
  //   aliases        alternate `kos menu summon <name>` routes; also searchable.
  //                  Reserved for established names users already type; new entries
  //                  should not normally add any.
  //   iconFont       font family used for the icon glyph, when it differs from the menu font
  //   title          header text shown when the submenu is open; defaults to label
  //   when           shell condition; hide row when it fails
  //   checked        shell condition; append ✓ when it succeeds

  // Root Menu
  "apps": {"icon":"󰀻","label":"Apps","aliases":["app","applications"],"provider":"apps"},
  "learn": {"icon":"󰧑","label":"Learn"},
  "trigger": {"icon":"󱓞","label":"Trigger"},
  "style": {"icon":"","label":"Style"},
  "setup": {"icon":"","label":"Setup","aliases":["settings"]},
  "install": {"icon":"󰉉","label":"Install"},
  "remove": {"icon":"󰭌","label":"Remove","aliases":["uninstall"]},
  "update": {"icon":"","label":"Update","aliases":["restart","refresh"]},
  "about": {"icon":"","label":"About","action":"kos-launch-about"},
  "system": {"icon":"","label":"System","aliases":["power-menu"]},

  // System
  "system.screensaver": {"icon":"󱄄","label":"Screensaver","action":"kos-launch-screensaver force"},
  "system.lock": {"icon":"","label":"Lock","action":"kos-system-lock"},
  "system.suspend": {"icon":"󰒲","label":"Suspend","when":"! kos-toggle-enabled suspend-off","action":"systemctl suspend"},
  "system.hibernate": {"icon":"󰤁","label":"Hibernate","when":"kos-hibernation-available","action":"systemctl hibernate"},
  "system.logout": {"icon":"󰍃","label":"Logout","action":"kos-system-logout"},
  "system.reboot": {"icon":"󰜉","label":"Reboot","action":"kos-system-reboot"},
  "system.shutdown": {"icon":"󰐥","label":"Shutdown","action":"kos-system-shutdown"},

  // Learn
  "learn.keybindings": {"icon":"","label":"Keybindings","action":"kos-menu-keybindings"},
  "learn.kos": {"icon":"","label":"Kos","action":"kos-launch-webapp 'https://github.com/kairosci/kos#readme'"},
  "learn.hyprland": {"icon":"","label":"Hyprland","action":"kos-launch-webapp 'https://wiki.hypr.land/'"},
  "learn.arch": {"icon":"󰣇","label":"Arch","action":"kos-launch-webapp 'https://wiki.archlinux.org/title/Main_page'"},
  "learn.neovim": {"icon":"","label":"Neovim","action":"kos-launch-webapp 'https://www.lazyvim.org/keymaps'"},
  "learn.bash": {"icon":"󱆃","label":"Bash","action":"kos-launch-webapp 'https://devhints.io/bash'"},
  "learn.tmux-keybindings": {"icon":"","label":"Tmux","action":"kos-menu-tmux-keybindings"},
  "learn.herdr-keybindings": {"icon":"","label":"Herdr","action":"kos-menu-herdr-keybindings"},
  "learn.community": {"icon":"󰙯","label":"Community","action":"kos-launch-discord-community"},

  // Trigger
  "trigger.emoji": {"icon":"","label":"Emoji","aliases":["emoji","emojis"],"action":"kos-menu-emoji"},
  "trigger.reminder": {"icon":"󰢌","label":"Reminder","aliases":["reminder"]},
  "trigger.capture": {"icon":"","label":"Capture","aliases":["capture","screenshot","screenrecord","screen-record","screenrecording"]},
  "trigger.capture.screenshot": {"icon":"","label":"Screenshot","action":"kos-capture-screenshot"},
  "trigger.capture.screenrecord.stop": {"icon":"","label":"Stop Screenrecording","when":"pgrep -f '^gpu-screen-recorder'","action":"kos-capture-screenrecording --stop-recording"},
  "trigger.capture.screenrecord": {"icon":"","label":"Screenrecord"},
  "trigger.capture.text": {"icon":"󰴑","label":"Text","action":"kos-capture-text"},
  "trigger.capture.qr": {"icon":"󰐲","label":"QR Code","action":"kos-capture-qr"},
  "trigger.capture.color": {"icon":"󰃉","label":"Color","action":"pkill hyprpicker || hyprpicker -a"},
  "trigger.capture.screenrecord.no-audio": {"icon":"","label":"With no audio","action":"kos-capture-screenrecording"},
  "trigger.capture.screenrecord.desktop-audio": {"icon":"","label":"With desktop audio","action":"kos-capture-screenrecording --with-desktop-audio"},
  "trigger.capture.screenrecord.microphone": {"icon":"","label":"With desktop + microphone audio","action":"kos-capture-screenrecording --with-desktop-audio --with-microphone-audio"},
  "trigger.capture.screenrecord.webcam": {"icon":"","label":"With desktop + microphone audio + webcam","when":"kos-hw-webcam","action":"kos-capture-screenrecording-with-webcam"},
  "trigger.transcode": {"icon":"󰧸","label":"Transcode","action":"kos-transcode"},
  "trigger.share": {"icon":"","label":"Share","aliases":["share"]},
  "trigger.toggle": {"icon":"󰔎","label":"Toggle","aliases":["toggle","toggles"]},
  "trigger.hardware": {"icon":"","label":"Hardware","aliases":["hardware","hw"]},
  "trigger.tests": {"icon":"󰓅","label":"Speed Test"},
  "trigger.hardware.laptop-display": {"icon":"󰛧","label":"Laptop Display","when":"kos-hw-laptop","action":"kos-hyprland-monitor-internal toggle"},
  "trigger.hardware.mirror-display": {"icon":"󰍹","label":"Mirror Display","when":"kos-hw-laptop","action":"kos-hyprland-monitor-internal-mirror toggle"},
  "trigger.hardware.hybrid-gpu": {"icon":"","label":"Hybrid GPU","when":"kos-hw-hybrid-gpu","action":"kos-launch-floating-terminal-with-presentation kos-toggle-hybrid-gpu"},
  "trigger.hardware.touchpad": {"icon":"󰟸","label":"Touchpad","when":"kos-hw-touchpad","action":"kos-toggle-touchpad"},
  "trigger.hardware.touchpad-haptics": {"icon":"󰌌","label":"Touchpad Haptics"},
  "trigger.hardware.touchpad-haptics.low": {"icon":"󰌌","label":"low","when":"kos-hw-dell-xps-haptic-touchpad && kos-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"low\" ]]","action":"dell-xps-touchpad-haptics set low"},
  "trigger.hardware.touchpad-haptics.mid": {"icon":"󰌌","label":"mid","when":"kos-hw-dell-xps-haptic-touchpad && kos-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"mid\" ]]","action":"dell-xps-touchpad-haptics set mid"},
  "trigger.hardware.touchpad-haptics.high": {"icon":"󰌌","label":"high","when":"kos-hw-dell-xps-haptic-touchpad && kos-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"high\" ]]","action":"dell-xps-touchpad-haptics set high"},
  "trigger.hardware.touchscreen": {"icon":"󰆽","label":"Touchscreen","when":"kos-hw-touchscreen","action":"kos-toggle-touchscreen"},
  "trigger.reminder.set": {"icon":"󰢌","label":"Set one","aliases":["reminder-set","remind"],"action":"kos-reminder -i"},
  "trigger.reminder.show": {"icon":"󰢌","label":"Show all","action":"kos-reminder show"},
  "trigger.reminder.clear": {"icon":"󰢌","label":"Clear all","action":"kos-reminder clear"},
  "trigger.share.clipboard": {"icon":"","label":"Clipboard","action":"kos-menu-share clipboard"},
  "trigger.share.file": {"icon":"","label":"File","action":"kos-menu-share file"},
  "trigger.share.folder": {"icon":"","label":"Folder","action":"kos-menu-share folder"},
  "trigger.share.receive": {"icon":"󰥦","label":"Receive","action":"uwsm-app -- localsend"},
  "trigger.toggle.idle-lock": {"icon":"󰅶","label":"Stay Awake","action":"kos-toggle-idle"},
  "trigger.toggle.notifications": {"icon":"󰂛","label":"Notifications","action":"kos-toggle-notification-silencing"},
  "trigger.toggle.crash-capture": {"icon":"󱚡","label":"Crash Capture","action":"kos-toggle-crash-capture"},
  "trigger.toggle.screensaver": {"icon":"󱄄","label":"Screensaver","action":"kos-toggle-screensaver"},
  "trigger.toggle.nightlight": {"icon":"󰔎","label":"Nightlight","action":"kos-toggle-nightlight"},
  "trigger.toggle.top-bar": {"icon":"󰍜","label":"Menu Bar","action":"kos-toggle-bar"},
  "trigger.toggle.battery-percentage": {"icon":"󰁹","label":"Battery Percentage","when":"kos-hw-laptop","action":"kos-shell kos.power togglePercentage"},
  "trigger.toggle.workspace-layout": {"icon":"󱂬","label":"Workspace Layout","action":"kos-hyprland-workspace-layout-toggle"},
  "trigger.toggle.window-gaps": {"icon":"","label":"Window Gaps","action":"kos-hyprland-window-gaps-toggle"},
  "trigger.toggle.one-window-ratio": {"icon":"","label":"1-Window Ratio","action":"kos-hyprland-window-single-square-aspect-toggle"},
  "trigger.tests.network-speedtest": {"icon":"󰓅","label":"Network Speed Test","action":"kos-shell shell summon kos.speedtest"},
  "trigger.tests.disk-speedtest": {"icon":"󰋊","label":"Disk Speed Test","action":"kos-shell shell summon kos.disk-speedtest"},

  // Style
  "style.theme": {"icon":"󰸌","label":"Theme","aliases":["theme","themes"],"action":"theme=$(kos-theme-switcher); [[ -n $theme ]] && kos-theme-set \"$theme\""},
  "style.background": {"icon":"","label":"Background","aliases":["background","wallpaper"],"action":"background=$(kos-theme-bg-switcher); [[ -n $background ]] && kos-theme-bg-set \"$background\""},
  "style.unlock": {"icon":"󰟵","label":"Unlock","aliases":["unlock"],"action":"unlock=$(kos-plymouth-switcher); if [[ $unlock == default ]]; then kos-launch-floating-terminal-with-presentation kos-plymouth-reset; elif [[ -n $unlock ]]; then kos-launch-floating-terminal-with-presentation \"kos-plymouth-set-by-theme $(printf %q \"$unlock\")\"; fi"},
  "style.font": {"icon":"","label":"Font","provider":"fonts"},
  "style.bar": {"icon":"󰍜","label":"Menu Bar"},
  "style.bar.position": {"icon":"","label":"Position"},
  "style.bar.transparency": {"icon":"󰂵","label":"Transparency","action":"kos-bar transparent toggle"},
  "style.hyprland": {"icon":"","label":"Hyprland","action":"kos-launch-config-editor \"$HOME/.config/hypr/looknfeel.lua\""},
  "style.screensaver": {"icon":"󱄄","label":"Screensaver"},
  "style.about": {"icon":"","label":"About"},
  "style.bar.position.top": {"icon":"󰁝","label":"Top","action":"kos-bar position top"},
  "style.bar.position.bottom": {"icon":"󰁅","label":"Bottom","action":"kos-bar position bottom"},
  "style.bar.position.left": {"icon":"󰁍","label":"Left","action":"kos-bar position left"},
  "style.bar.position.right": {"icon":"󰁔","label":"Right","action":"kos-bar position right"},
  "style.about.text": {"icon":"","label":"Edit Text","action":"kos-branding-about text"},
  "style.about.image": {"icon":"","label":"Set From Image","action":"kos-branding-about image"},
  "style.about.default": {"icon":"","label":"Restore Default","action":"kos-branding-about reset"},
  "style.screensaver.text": {"icon":"","label":"Edit Text","action":"kos-branding-screensaver text"},
  "style.screensaver.image": {"icon":"","label":"Set From Image","action":"kos-branding-screensaver image"},
  "style.screensaver.default": {"icon":"","label":"Restore Default","action":"kos-branding-screensaver reset"},

  // Setup
  "setup.monitors": {"icon":"󰍹","label":"Monitors","action":"kos-launch-config-editor \"$HOME/.config/hypr/monitors.lua\""},
  "setup.keybindings": {"icon":"","label":"Keybindings","when":"[[ -f ~/.config/hypr/bindings.lua ]]","action":"kos-launch-config-editor \"$HOME/.config/hypr/bindings.lua\""},
  "setup.input": {"icon":"","label":"Input","when":"[[ -f ~/.config/hypr/input.lua ]]","action":"kos-launch-config-editor \"$HOME/.config/hypr/input.lua\""},
  "setup.network": {"icon":"󰛳","label":"Network","aliases":["network"]},
  "setup.network.dns": {"icon":"󰇖","label":"DNS","aliases":["dns"]},
  "setup.network.dns.dhcp": {"icon":"󰩟","label":"DHCP","checked":"[[ \"$(kos-dns)\" == \"DHCP\" ]]","action":"kos-dns DHCP"},
  "setup.network.dns.cloudflare": {"icon":"󰅟","label":"Cloudflare","checked":"[[ \"$(kos-dns)\" == \"Cloudflare\" ]]","action":"kos-dns Cloudflare"},
  "setup.network.dns.google": {"icon":"󰊭","label":"Google","checked":"[[ \"$(kos-dns)\" == \"Google\" ]]","action":"kos-dns Google"},
  "setup.network.dns.custom": {"icon":"","label":"Custom","checked":"[[ \"$(kos-dns)\" == \"Custom\" ]]","action":"kos-launch-floating-terminal-with-presentation 'kos-dns Custom'"},
  "setup.network.qr": {"icon":"󰐲","label":"QR Code","aliases":["wifi-qr"],"when":"[[ $(kos-network-status) == wifi* ]]","action":"kos-shell shell summon kos.wifiqr"},
  "setup.default": {"icon":"","label":"Defaults","aliases":["default","defaults"]},
  "setup.default.agent": {"icon":"󰚩","label":"Agent","title":"Default Agent"},
  "setup.default.agent.claude": {"icon":"󰛄","label":"Claude","checked":"[[ \"$(kos-default-agent)\" == \"claude\" ]]","action":"kos-default-agent claude"},
  "setup.default.agent.codex": {"icon":"","iconFont":"kos","label":"Codex","checked":"[[ \"$(kos-default-agent)\" == \"codex\" ]]","action":"kos-default-agent codex"},
  "setup.default.agent.copilot": {"icon":"","label":"Copilot","checked":"[[ \"$(kos-default-agent)\" == \"copilot\" ]]","action":"kos-default-agent copilot"},
  "setup.default.agent.crush": {"icon":"󰋑","label":"Crush","checked":"[[ \"$(kos-default-agent)\" == \"crush\" ]]","action":"kos-default-agent crush"},
  "setup.default.agent.cursor-agent": {"icon":"","iconFont":"kos","label":"Cursor CLI","checked":"[[ \"$(kos-default-agent)\" == \"cursor-agent\" ]]","action":"kos-default-agent cursor-agent"},
  "setup.default.agent.gemini": {"icon":"󰫢","label":"Gemini","checked":"[[ \"$(kos-default-agent)\" == \"gemini\" ]]","action":"kos-default-agent gemini"},
  "setup.default.agent.grok": {"icon":"","iconFont":"kos","label":"Grok","checked":"[[ \"$(kos-default-agent)\" == \"grok\" ]]","action":"kos-default-agent grok"},
  "setup.default.agent.hermes": {"icon":"","iconFont":"kos","label":"Hermes","checked":"[[ \"$(kos-default-agent)\" == \"hermes\" ]]","action":"kos-default-agent hermes"},
  "setup.default.agent.muse": {"icon":"󰛤","label":"Muse Code","checked":"[[ \"$(kos-default-agent)\" == \"muse\" ]]","action":"kos-default-agent muse"},
  "setup.default.agent.omp": {"icon":"","iconFont":"kos","label":"omp","checked":"[[ \"$(kos-default-agent)\" == \"omp\" ]]","action":"kos-default-agent omp"},
  "setup.default.agent.openclaw": {"icon":"","iconFont":"kos","label":"OpenClaw","checked":"[[ \"$(kos-default-agent)\" == \"openclaw\" ]]","action":"kos-default-agent openclaw"},
  "setup.default.agent.opencode": {"icon":"","iconFont":"kos","label":"OpenCode","checked":"[[ \"$(kos-default-agent)\" == \"opencode\" ]]","action":"kos-default-agent opencode"},
  "setup.default.agent.pi": {"icon":"","iconFont":"kos","label":"Pi","checked":"[[ \"$(kos-default-agent)\" == \"pi\" ]]","action":"kos-default-agent pi"},
  "setup.default.browser": {"icon":"","label":"Browser","title":"Default Browser"},
  "setup.default.browser.chromium": {"icon":"","label":"Chromium","when":"kos-cmd-present chromium","checked":"[[ \"$(kos-default-browser)\" == \"chromium\" ]]","action":"kos-default-browser chromium"},
  "setup.default.browser.chrome": {"icon":"󰊯","label":"Chrome","when":"kos-cmd-present google-chrome-stable","checked":"[[ \"$(kos-default-browser)\" == \"chrome\" ]]","action":"kos-default-browser chrome"},
  "setup.default.browser.brave": {"icon":"󰖟","label":"Brave","when":"kos-cmd-present brave","checked":"[[ \"$(kos-default-browser)\" == \"brave\" ]]","action":"kos-default-browser brave"},
  "setup.default.browser.brave-origin": {"icon":"󰖟","label":"Brave Origin","when":"kos-cmd-present brave-origin","checked":"[[ \"$(kos-default-browser)\" == \"brave-origin\" ]]","action":"kos-default-browser brave-origin"},
  "setup.default.browser.edge": {"icon":"󰇩","label":"Edge","when":"kos-cmd-present microsoft-edge-stable","checked":"[[ \"$(kos-default-browser)\" == \"edge\" ]]","action":"kos-default-browser edge"},
  "setup.default.browser.firefox": {"icon":"","label":"Firefox","when":"kos-cmd-present firefox","checked":"[[ \"$(kos-default-browser)\" == \"firefox\" ]]","action":"kos-default-browser firefox"},
  "setup.default.browser.zen": {"icon":"󰖟","label":"Zen","when":"kos-cmd-present zen-browser","checked":"[[ \"$(kos-default-browser)\" == \"zen\" ]]","action":"kos-default-browser zen"},
  "setup.default.terminal": {"icon":"","label":"Terminal","title":"Default Terminal"},
  "setup.default.terminal.alacritty": {"icon":"","label":"Alacritty","when":"kos-cmd-present alacritty","checked":"[[ \"$(kos-default-terminal)\" == \"alacritty\" ]]","action":"kos-default-terminal alacritty"},
  "setup.default.terminal.foot": {"icon":"","label":"Foot","when":"kos-cmd-present foot","checked":"[[ \"$(kos-default-terminal)\" == \"foot\" ]]","action":"kos-default-terminal foot"},
  "setup.default.terminal.ghostty": {"icon":"","label":"Ghostty","when":"kos-cmd-present ghostty","checked":"[[ \"$(kos-default-terminal)\" == \"ghostty\" ]]","action":"kos-default-terminal ghostty"},
  "setup.default.terminal.kitty": {"icon":"","label":"Kitty","when":"kos-cmd-present kitty","checked":"[[ \"$(kos-default-terminal)\" == \"kitty\" ]]","action":"kos-default-terminal kitty"},
  "setup.default.editor": {"icon":"","label":"Editor","title":"Default Editor"},
  "setup.default.editor.neovim": {"icon":"","label":"Neovim","when":"kos-cmd-present nvim","checked":"[[ \"$(kos-default-editor)\" == \"nvim\" ]]","action":"kos-default-editor nvim"},
  "setup.default.editor.vscode": {"icon":"","label":"VSCode","when":"kos-cmd-present code","checked":"[[ \"$(kos-default-editor)\" == \"code\" ]]","action":"kos-default-editor code"},
  "setup.default.editor.cursor": {"icon":"","iconFont":"kos","label":"Cursor","when":"kos-cmd-present cursor","checked":"[[ \"$(kos-default-editor)\" == \"cursor\" ]]","action":"kos-default-editor cursor"},
  "setup.default.editor.zed": {"icon":"","label":"Zed","when":"kos-cmd-present zeditor","checked":"[[ \"$(kos-default-editor)\" == \"zeditor\" ]]","action":"kos-default-editor zed"},
  "setup.default.editor.sublime": {"icon":"","label":"Sublime Text","when":"kos-cmd-present sublime_text","checked":"[[ \"$(kos-default-editor)\" == \"sublime_text\" ]]","action":"kos-default-editor sublime_text"},
  "setup.default.editor.helix": {"icon":"","label":"Helix","when":"kos-cmd-present helix","checked":"[[ \"$(kos-default-editor)\" == \"helix\" ]]","action":"kos-default-editor helix"},
  "setup.default.editor.vim": {"icon":"","label":"Vim","when":"kos-cmd-present vim","checked":"[[ \"$(kos-default-editor)\" == \"vim\" ]]","action":"kos-default-editor vim"},
  "setup.default.editor.emacs": {"icon":"","label":"Emacs","when":"kos-cmd-present emacs","checked":"[[ \"$(kos-default-editor)\" == \"emacs\" ]]","action":"kos-default-editor emacs"},
  "setup.plugin": {"icon":"󰐱","label":"Plugins","aliases":["plugin","plugins"]},
  "setup.plugin.enable": {"icon":"󰄬","label":"Enable Plugin","action":"kos-menu-plugin enable"},
  "setup.plugin.disable": {"icon":"󰅖","label":"Disable Plugin","action":"kos-menu-plugin disable"},
  "setup.plugin.add": {"icon":"󰖟","label":"Add Plugin","action":"kos-launch-floating-terminal-with-presentation 'kos-plugin-add'"},
  "setup.plugin.clone": {"icon":"󰆏","label":"Clone Plugin","action":"kos-menu-plugin clone"},
  "setup.plugin.remove": {"icon":"󰭌","label":"Remove Plugin","when":"compgen -G \"$HOME/.config/kos/plugins/*/manifest.json\"","action":"kos-menu-plugin remove"},
  "setup.security": {"icon":"","label":"Security"},
  "setup.config": {"icon":"","label":"Config"},
  "setup.security.fingerprint": {"icon":"󰈷","label":"Fingerprint","when":"kos-hw-fingerprint","action":"kos-launch-floating-terminal-with-presentation kos-setup-security-fingerprint"},
  "setup.security.fido2": {"icon":"","label":"Fido2","action":"kos-launch-floating-terminal-with-presentation kos-setup-security-fido2"},
  "setup.security.sshd": {"icon":"󰣀","label":"SSHD","action":"kos-launch-floating-terminal-with-presentation kos-setup-security-sshd"},
  "setup.security.passwordless-sudo": {"icon":"󰟵","label":"Passwordless Sudo","action":"kos-launch-floating-terminal-with-presentation kos-sudo-passwordless"},
  "setup.security.sudoless-docker": {"icon":"󰡨","label":"Sudoless Docker","when":"kos-sudo-docker --configured","action":"kos-launch-floating-terminal-with-presentation kos-setup-security-sudoless-docker"},
  "setup.config.hyprland": {"icon":"","label":"Hyprland","action":"kos-launch-config-editor \"$HOME/.config/hypr/hyprland.lua\""},
  "setup.config.hyprsunset": {"icon":"","label":"Hyprsunset","action":"kos-launch-config-editor ~/.config/hypr/hyprsunset.conf && kos-restart-hyprsunset"},
  "setup.config.xcompose": {"icon":"󰞅","label":"XCompose","action":"kos-launch-config-editor ~/.XCompose && kos-restart-xcompose"},
  "setup.direct-boot": {"icon":"","label":"Direct Boot","action":"kos-launch-floating-terminal-with-presentation kos-setup-direct-boot"},
  "setup.reset": {"icon":"󰑓","label":"Reset Computer","when":"[[ $(findmnt -no FSTYPE /) == btrfs ]]","action":"kos-launch-floating-terminal-with-presentation kos-system-factory-reset"},

  // Install
  "install.package": {"icon":"󰣇","label":"Package","action":"xdg-terminal-exec --app-id=org.kos.terminal kos-pkg-install"},
  "install.aur": {"icon":"󰣇","label":"AUR","action":"xdg-terminal-exec --app-id=org.kos.terminal kos-pkg-aur-install"},
  "install.webapp": {"icon":"","label":"Web App","action":"kos-launch-floating-terminal-with-presentation kos-webapp-install"},
  "install.tui": {"icon":"","label":"TUI","action":"kos-launch-floating-terminal-with-presentation kos-tui-install"},
  "install.style": {"icon":"","label":"Style"},
  "install.style.theme": {"icon":"󰸌","label":"Theme","action":"kos-launch-floating-terminal-with-presentation kos-theme-install"},
  "install.style.background": {"icon":"","label":"Background","action":"kos-theme-bg-install"},
  "install.style.font": {"icon":"","label":"Font"},
  "install.style.font.cascadia": {"icon":"","label":"Cascadia Mono","action":"kos-install-font 'Cascadia Mono' ttf-cascadia-mono-nerd 'CaskaydiaMono Nerd Font'"},
  "install.style.font.meslo": {"icon":"","label":"Meslo LG Mono","action":"kos-install-font 'Meslo LG Mono' ttf-meslo-nerd 'MesloLGL Nerd Font'"},
  "install.style.font.fira": {"icon":"","label":"Fira Code","action":"kos-install-font 'Fira Code' ttf-firacode-nerd 'FiraCode Nerd Font'"},
  "install.style.font.victor": {"icon":"","label":"Victor Code","action":"kos-install-font 'Victor Code' ttf-victor-mono-nerd 'VictorMono Nerd Font'"},
