#!/bin/bash

set -e

# Only invite when there's a reader to use and it isn't set up yet (the lock
# PAM file is the last thing the setup writes on success).
if kos-hw-fingerprint && [[ ! -f /etc/pam.d/kos-lock-fingerprint ]] &&
  kos-done ensure fingerprint-setup-invitation; then
  kos-notification-send -u critical -g 󰈷 "Setup Fingerprint Reader" \
    "Enable sudo and unlocking with your fingerprint." \
    --exec kos-launch-floating-terminal-with-presentation kos-setup-security-fingerprint
fi
