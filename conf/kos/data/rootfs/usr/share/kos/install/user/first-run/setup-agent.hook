#!/bin/bash

set -e

# Kos ships no default agent, so invite once rather than picking one. An
# agent already chosen means the invitation has nothing to offer.
if [[ -z $(kos-default-agent) ]] && kos-done ensure agent-setup-invitation; then
  kos-notification-send -u critical -g 󰚩 "Set your default agent" \
    "Let your favorite agent help with Kos." \
    --exec kos menu summon setup.default.agent
fi
