[Trigger]
Operation = Upgrade
Operation = Install
Operation = Remove
Type = Package
Target = *

[Action]
Description = Waiting for limine-snapper-sync to finish...
When = PreTransaction
Exec = /usr/share/libalpm/scripts/limine-snapper-lock
NeedsTargets
