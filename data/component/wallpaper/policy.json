{
  "defaultGeometry": "1920x1080",
  "variants": [
    {
      "id": "krepo",
      "role": "accent",
      "size": 0.42,
      "opacity": 1,
      "gravity": "center"
    }
  ],
  "platformVariable": "OMARCHY_PATH",
  "platformRoot": "/usr/share/omarchy",
  "themes": "themes",
  "colors": "colors.toml",
  "overlay": "omarchy/themes",
  "current": "omarchy/current",
  "colorKeys": [
    "background",
    "foreground",
    "accent"
  ],
  "logo": "data/component/wallpaper/krepo.png",
  "output": "os/backgrounds",
  "chooser": "omarchy/backgrounds",
  "archive": "os/retired-backgrounds",
  "cache": ".os-wallpaper.sha256",
  "paddingDivisor": 12,
  "mode": "644",
  "policyFile": "data/component/wallpaper/policy.json",
  "runtime": "os/desktop/runtime",
  "retiredRuntime": "os/desktop/scripts/wallpaper.sh",
  "userThemes": "os/themes",
  "renderArguments": [
    "-size",
    "{geometry}",
    "canvas:{background}",
    "(",
    "{logo}",
    "-fill",
    "{color}",
    "-colorize",
    "100",
    "-channel",
    "A",
    "-evaluate",
    "multiply",
    "{opacity}",
    "+channel",
    "-resize",
    "{side}x{side}",
    ")",
    "-gravity",
    "{gravity}",
    "-geometry",
    "{offset}",
    "-composite",
    "-strip",
    "-depth",
    "8",
    "-density",
    "72",
    "{destination}"
  ],
  "files": {
    "themeName": "theme.name",
    "activePalette": "theme/colors.toml",
    "stockBackgrounds": "theme/backgrounds",
    "activeBackground": "background"
  },
  "runtimeCurrent": "current",
  "runtimeManifest": "manifest.json",
  "runtimeRequired": [
    "script/os-lua",
    "src/main.lua",
    "src/component/runtime/application.lua",
    "src/component/boot/menu.lua",
    "src/component/wallpaper/renderer.lua",
    "src/component/wallpaper/catalog.lua",
    "src/component/wallpaper/installer.lua",
    "src/core/file.lua",
    "src/core/json.lua",
    "src/core/process.lua",
    "src/core/catalog.lua",
    "src/core/paths.lua",
    "src/core/publisher.lua",
    "data/core/bootstrap.env",
    "data/core/layout.json",
    "data/core/commands.json",
    "data/core/locale.json",
    "data/core/paths.json",
    "data/component/wallpaper/policy.json",
    "data/component/wallpaper/krepo.png",
    "data/catalog/en.msg",
    "data/catalog/it.msg",
    "data/catalog/fr.msg",
    "data/catalog/de.msg",
    "data/catalog/es.msg",
    "data/catalog/pt.msg"
  ]
}
