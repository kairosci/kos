#!/bin/bash
set -euo pipefail
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
OS_I18N_BOOT="${OS_I18N_BOOT:-$SCRIPT_DIR/../i18n/i18n-boot.sh}"
[[ -f "$OS_I18N_BOOT" ]] || OS_I18N_BOOT="$SCRIPT_DIR/../../scripts/lib/i18n-boot.sh"
if [[ $EUID -eq 0 ]]; then
    export PATH=/usr/bin:/usr/sbin:/bin:/sbin
    THEME_POLICY_FILE=/usr/local/lib/os/excluded-themes.list
    THEME_POLICY_ROOT=/usr/share/omarchy/themes
    THEME_POLICY_HOMES=/home
    THEME_POLICY_ARCHIVE=/var/lib/os/retired-themes
    export THEME_PREVIEW_THEMES_ROOT=/usr/share/omarchy/themes
    export THEME_PREVIEW_BACKUP_DIR=/var/cache/os/theme-preview-stock
    export THEME_PREVIEW_OVERLAY_STORE=/var/lib/os/theme-preview-overlay
    export OS_I18N_DIR=/usr/local/lib/os/messages
    OS_I18N_BOOT=/usr/local/lib/os/i18n.sh
    source "$OS_I18N_BOOT"
    locale_init
    # shellcheck source=scripts/lib/theme-policy.sh
    source /usr/local/lib/os/theme-policy.sh
    theme_policy_apply || err "theming.policy_failed"
elif [[ -f "$OS_I18N_BOOT" ]]; then
    . "$OS_I18N_BOOT"
else
    warn() { printf '%s: %s\n' "Warning" "$1" >&2; }
fi
run_as_user() {
  local _ru="$1"
  shift
  if [[ "$_ru" == "$(id -un 2>/dev/null)" ]]; then
    "$@" || return 1
  else
    sudo -u "$_ru" "$@" || return 1
  fi
}
OS_DESKTOP_WORKFLOW="${OS_DESKTOP_WORKFLOW:-$SCRIPT_DIR/../lib/desktop-workflow.sh}"
[[ -f "$OS_DESKTOP_WORKFLOW" ]] || OS_DESKTOP_WORKFLOW="$SCRIPT_DIR/../../scripts/lib/desktop-workflow.sh"
if [[ $EUID -eq 0 ]]; then
    OS_DESKTOP_WORKFLOW=/usr/local/lib/os/desktop-workflow.sh
    export DESKTOP_WORKFLOW_MPV_ENTRY=/usr/local/lib/os/mpv.desktop
fi
source "$OS_DESKTOP_WORKFLOW"
DESKTOP_WORKFLOW_PORTALS="$SCRIPT_DIR/../lib/portals.conf"
[[ -f "$DESKTOP_WORKFLOW_PORTALS" ]] || DESKTOP_WORKFLOW_PORTALS="$SCRIPT_DIR/../../modules/conf/xdg-desktop-portal/data/portals.conf"
if [[ $EUID -eq 0 ]]; then
    DESKTOP_WORKFLOW_PORTALS=/usr/local/lib/os/portals.conf
fi
user_as() {
    local user="$1" uid home
    shift
    uid=$(id -u "$user") || return 1
    home=$(getent passwd "$user" | cut -d: -f6) || return 1
    run_as_user "$user" env "HOME=$home" "XDG_RUNTIME_DIR=/run/user/$uid" \
        "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus" "$@"
}
OS_THEME_PREVIEW="${OS_THEME_PREVIEW:-$SCRIPT_DIR/../lib/theme-preview.sh}"
[[ -f "$OS_THEME_PREVIEW" ]] || OS_THEME_PREVIEW="$SCRIPT_DIR/../../modules/theme-previews/scripts/lib/theme-preview.sh"
if [[ $EUID -eq 0 ]]; then
    OS_THEME_PREVIEW=/usr/local/lib/os/theme-preview.sh
fi
if [[ -f "$OS_THEME_PREVIEW" ]]; then
  source "$OS_THEME_PREVIEW"
fi
if [[ $EUID -eq 0 ]] && declare -F theme_preview_normalize >/dev/null; then
  theme_preview_normalize
fi
if [[ $EUID -eq 0 && -x /usr/local/libexec/os-desktop-cleanup ]]; then
  /usr/local/libexec/os-desktop-cleanup 2>/dev/null || warn "hooks.desktop_reapply_skipped" "all"
fi
if [[ $EUID -eq 0 ]]; then
    user_homes=(/home/*)
else
    user_homes=("$HOME")
fi
for user_home in "${user_homes[@]}"; do
  [[ -d "$user_home" ]] || continue
  if [[ $EUID -eq 0 ]]; then
    _user=$(basename "$user_home")
  else
    _user=$(id -un)
  fi
  _uid=$(id -u "$_user" 2>/dev/null) || continue
  if [[ -e "/run/user/$_uid/bus" ]]; then
    user_as "$_user" gsettings set org.gnome.desktop.interface cursor-theme "capitaine-cursors" || warn "hooks.cursor_reapply_skipped" "$_user"
  fi
  if [[ -n "$_uid" && -d "/run/user/$_uid" ]]; then
    _user_env=(env "XDG_RUNTIME_DIR=/run/user/$_uid" "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$_uid/bus")
    run_as_user "$_user" "${_user_env[@]}" systemctl --user disable --now omarchy-crash-watch.service 2>/dev/null || warn "hooks.crashwatch_disable_skipped" "$_user"
    run_as_user "$_user" "${_user_env[@]}" systemctl --user mask omarchy-crash-watch.service 2>/dev/null || warn "hooks.crashwatch_mask_skipped" "$_user"
  fi
  desktop_workflow_defaults "$_user" "$user_home" || warn "hooks.desktop_reapply_skipped" "$_user"
  desktop_workflow_portals "$_user" "$user_home" || warn "hooks.portal_reload_skipped" "$_user"
  if [[ $EUID -eq 0 && -x /usr/local/lib/os/session/install.sh ]]; then
    user_as "$_user" bash /usr/local/lib/os/session/install.sh || err "session.validation_failed" "$_user"
  fi
  for _hook in folder-color gtk-theme shell-icons; do
    _hook_path="$user_home/.config/os/hooks/theme-set.d/$_hook"
    if [[ -f "$_hook_path" ]]; then
      user_as "$_user" bash "$_hook_path" || warn "hooks.icons_reapply_skipped" "$_user"
    fi
  done
done
