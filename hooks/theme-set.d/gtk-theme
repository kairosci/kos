#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
KOS_I18N_BOOT="${KOS_I18N_BOOT:-$SCRIPT_DIR/../i18n/i18n-boot.sh}"
[[ -f "$KOS_I18N_BOOT" ]] || KOS_I18N_BOOT="$SCRIPT_DIR/../../scripts/lib/i18n-boot.sh"
source "$KOS_I18N_BOOT"

COLORS="${KOS_THEME_COLORS:-$HOME/.local/state/kos/current/theme/colors.toml}"
[[ -r "$COLORS" ]] || exit 0
palette() {
    awk -F '"' -v key="$1" '$1 ~ "^[[:space:]]*" key "[[:space:]]*=" { print $2; exit }' "$COLORS"
}
BACKGROUND="$(palette background)"
FOREGROUND="$(palette foreground)"
ACCENT="$(palette accent)"
SELECTION="$(palette selection)"
for color in "$BACKGROUND" "$FOREGROUND" "$ACCENT" "$SELECTION"; do
    [[ "$color" =~ ^#[0-9a-fA-F]{6}$ ]] || { warn "hooks.gtk_palette_failed" "$COLORS"; exit 1; }
done
MODE="$(palette mode)"
[[ "$MODE" == light ]] || MODE=dark
if [[ "$MODE" == light ]]; then
    GTK_BASE_THEME=Materia-light
    GTK_DARK=false
    GTK_ICONS=Kos-Qogir
else
    GTK_BASE_THEME=Materia-dark
    GTK_DARK=true
    GTK_ICONS=Kos-Qogir
fi
mix_color() {
    local percentage="$1" channel a b
    printf '#'
    for channel in 1 3 5; do
        a=$((16#${BACKGROUND:channel:2}))
        b=$((16#${FOREGROUND:channel:2}))
        printf '%02x' "$(( (a * (100 - percentage) + b * percentage) / 100 ))"
    done
}
SURFACE=$BACKGROUND
HOVER=$(mix_color 10)
BORDER=$(mix_color 18)
MUTED=$(mix_color 55)
THEME_HASH=$(printf '%s\n' "$BACKGROUND" "$FOREGROUND" "$ACCENT" "$SELECTION" "$MODE" "ui-flat-v8" | sha256sum)
GTK_THEME_NAME="Kos-${THEME_HASH:0:16}"
GTK_THEME_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/themes/$GTK_THEME_NAME"
mkdir -p "$GTK_THEME_DIR/gtk-3.0" "$GTK_THEME_DIR/gtk-4.0"

for version in 3 4; do
    config="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-$version.0"
    mkdir -p "$config"
    settings="$(mktemp "$config/.settings.XXXXXX")"
    if [[ -f "$config/settings.ini" ]]; then cat "$config/settings.ini" > "$settings"; fi
    temporary="$(mktemp "$config/.settings-new.XXXXXX")"
    awk -v theme="$GTK_THEME_NAME" -v dark="$GTK_DARK" -v icons="$GTK_ICONS" '
        function managed() {
            print "gtk-theme-name=" theme
            print "gtk-application-prefer-dark-theme=" dark
            print "gtk-icon-theme-name=" icons
            print "gtk-cursor-theme-name=capitaine-cursors"
        }
        /^\[Settings\]$/ { in_settings=1; found=1; print; managed(); next }
        /^\[/ { in_settings=0 }
        in_settings && /^gtk-(theme-name|application-prefer-dark-theme|icon-theme-name|cursor-theme-name)=/ { next }
        { print }
        END { if (!found) { print "[Settings]"; managed() } }
    ' "$settings" > "$temporary"
    chmod 644 "$temporary"
    mv -f "$temporary" "$config/settings.ini"
    rm -f "$settings"
    temporary="$(mktemp "$config/.kos.XXXXXX")"
    cat > "$temporary" <<EOF_CSS
@define-color theme_bg_color $BACKGROUND;
@define-color theme_base_color $BACKGROUND;
@define-color theme_fg_color $FOREGROUND;
@define-color theme_text_color $FOREGROUND;
@define-color theme_selected_bg_color $SELECTION;
@define-color theme_selected_fg_color $FOREGROUND;
@define-color accent_bg_color $ACCENT;
@define-color accent_color $ACCENT;
@define-color accent_fg_color $BACKGROUND;
* { border-radius: 0; box-shadow: none; text-shadow: none; background-image: none; transition: none; }
window, dialog, .background, menubar, menu, menuitem, notebook, notebook header, notebook tab, viewport, scrolledwindow, stack, .view, .card, .boxed-list, .boxed-list row, popover > contents, tooltip { background-color: $BACKGROUND; color: $FOREGROUND; }
headerbar, toolbar, .sidebar { background-color: $SURFACE; color: $FOREGROUND; }
treeview, iconview, textview, entry, list { background-color: $BACKGROUND; color: $FOREGROUND; }
view:selected, treeview:selected, iconview:selected, .view:selected, row:selected { background-color: $SELECTION; color: $FOREGROUND; }
window, dialog, .background, .navigation-sidebar, .card, .boxed-list, .boxed-list row, popover > contents, menu, tooltip, headerbar, entry, button, notebook tab { border-radius: 0; box-shadow: none; background-image: none; }
decoration { border-radius: 0; box-shadow: none; margin: 0; }
headerbar, toolbar { min-height: 30px; padding: 3px 6px; box-shadow: none; border-bottom: 1px solid $BORDER; }
headerbar windowcontrols { margin: 0; }
button { border-radius: 0; border-color: $BORDER; background-image: none; box-shadow: none; padding: 4px 8px; }
entry { border-radius: 0; min-height: 24px; padding: 3px 6px; }
.navigation-sidebar row, .sidebar row { border-radius: 0; padding: 4px 8px; }
.navigation-sidebar { background-color: $SURFACE; color: $FOREGROUND; }
popover > contents, tooltip { border: 1px solid $BORDER; }
button:focus-visible, entry:focus-visible, row:focus-visible { outline: 2px solid $ACCENT; outline-offset: -2px; }
button:hover { background-color: $HOVER; border-color: $ACCENT; }
entry:focus { border-color: $ACCENT; }
toolbar button { min-height: 20px; min-width: 20px; padding: 3px 5px; }
separator { background-color: $BORDER; }
notebook tab:checked { border-bottom: 2px solid $ACCENT; }
button:checked, switch:checked, check:checked, radio:checked, scale highlight, progressbar progress { background-color: $ACCENT; color: $BACKGROUND; }
button:disabled, entry:disabled { color: $MUTED; }
button.flat, button.image-button, .sidebar row, .navigation-sidebar row { background-color: transparent; border-color: transparent; }
button.flat:hover, button.image-button:hover, row:hover { background-color: $HOVER; }
row:selected, row:selected:hover, .sidebar row:selected, .navigation-sidebar row:selected { background-color: $SELECTION; color: $FOREGROUND; }
button.suggested-action { background-color: $ACCENT; color: $BACKGROUND; border-color: $ACCENT; }
entry selection, textview text selection { background-color: $SELECTION; color: $FOREGROUND; }
check, radio { border: 1px solid $BORDER; }
check:checked, radio:checked { border-color: $ACCENT; }
scale trough, progressbar trough { background-color: $HOVER; }
scrollbar trough { background-color: transparent; }
scrollbar slider { min-width: 8px; min-height: 8px; margin: 0; padding: 0; background-color: $MUTED; border: none; }
scrollbar slider:hover { background-color: $ACCENT; }
button, entry, spinbutton, searchentry, combobox, dropdown, row, menuitem, modelbutton, notebook tab, tabs tab, check, radio, switch, switch slider, scale slider, scrollbar slider, expander, link, .link {
  transition: background-color 120ms ease-out, color 120ms ease-out, border-color 120ms ease-out, outline-color 120ms ease-out;
}
scale highlight, progressbar progress, levelbar block {
  transition: background-color 140ms ease-out, border-color 140ms ease-out;
}
button:active, row:active, menuitem:active { transition-duration: 60ms; }
button:disabled, entry:disabled, spinbutton:disabled, check:disabled, radio:disabled, switch:disabled { transition: none; }
.link, link { color: $ACCENT; }

EOF_CSS
    if [[ "$version" == 4 ]]; then
        cat >> "$temporary" <<EOF_CSS
:root {
  --window-bg-color: $BACKGROUND;
  --window-fg-color: $FOREGROUND;
  --view-bg-color: $BACKGROUND;
  --view-fg-color: $FOREGROUND;
  --headerbar-bg-color: $SURFACE;
  --headerbar-fg-color: $FOREGROUND;
  --sidebar-bg-color: $SURFACE;
  --sidebar-fg-color: $FOREGROUND;
  --card-bg-color: $BACKGROUND;
  --card-fg-color: $FOREGROUND;
  --dialog-bg-color: $BACKGROUND;
  --dialog-fg-color: $FOREGROUND;
  --popover-bg-color: $BACKGROUND;
  --popover-fg-color: $FOREGROUND;
  --accent-bg-color: $ACCENT;
  --accent-fg-color: $BACKGROUND;
  --accent-color: $ACCENT;
  --border-opacity: 0.15;
}
EOF_CSS
    fi
    chmod 644 "$temporary"
    mv -f "$temporary" "$config/kos.css"
    if [[ "$version" == 3 ]]; then
        if [[ -f "$config/gtk.css" ]]; then
            temporary="$(mktemp "$config/.gtk.XXXXXX")"
            awk '$0 != "@import url(\"kos.css\");" { print }' "$config/gtk.css" > "$temporary"
            chmod 644 "$temporary"
            mv -f "$temporary" "$config/gtk.css"
        fi
        printf '@import url("/usr/share/themes/%s/gtk-3.0/gtk.css");\n' "$GTK_BASE_THEME" > "$GTK_THEME_DIR/gtk-3.0/gtk.css"
        cat "$config/kos.css" >> "$GTK_THEME_DIR/gtk-3.0/gtk.css"
        cp "$GTK_THEME_DIR/gtk-3.0/gtk.css" "$GTK_THEME_DIR/gtk-3.0/gtk-dark.css"
    else
        cp "$config/kos.css" "$GTK_THEME_DIR/gtk-4.0/gtk.css"
        cp "$config/kos.css" "$GTK_THEME_DIR/gtk-4.0/gtk-dark.css"
    fi
    if [[ "$version" == 4 ]] && ! grep -qFx '@import url("kos.css");' "$config/gtk.css" 2>/dev/null; then
        temporary="$(mktemp "$config/.gtk.XXXXXX")"
        printf '%s\n' '@import url("kos.css");' > "$temporary"
        if [[ -f "$config/gtk.css" ]]; then cat "$config/gtk.css" >> "$temporary"; fi
        chmod 644 "$temporary"
        mv -f "$temporary" "$config/gtk.css"
    fi
done
printf '[Desktop Entry]\nName=%s\nType=X-GNOME-Metatheme\n[X-GNOME-Metatheme]\nGtkTheme=%s\nIconTheme=%s\n' "$GTK_THEME_NAME" "$GTK_THEME_NAME" "$GTK_ICONS" > "$GTK_THEME_DIR/index.theme"

if [[ -z "${KOS_THEME_COLORS:-}" && -S "${XDG_RUNTIME_DIR:-/nonexistent}/bus" ]]; then
    gsettings set org.gnome.desktop.interface gtk-theme "$GTK_THEME_NAME"
    gsettings set org.gnome.desktop.interface color-scheme "prefer-$MODE"
    gsettings set org.gnome.desktop.interface icon-theme "$GTK_ICONS"
    gsettings set io.github.celluloid-player.Celluloid dark-theme-enable "$GTK_DARK"
fi
