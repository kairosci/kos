#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
OS_I18N_BOOT="${OS_I18N_BOOT:-$SCRIPT_DIR/../i18n/i18n-boot.sh}"
[[ -f "$OS_I18N_BOOT" ]] || OS_I18N_BOOT="$SCRIPT_DIR/../../scripts/lib/i18n-boot.sh"
source "$OS_I18N_BOOT"

COLORS="${OS_THEME_COLORS:-$HOME/.local/state/omarchy/current/theme/colors.toml}"
[[ -r "$COLORS" ]] || exit 0
palette() {
    awk -F '"' -v key="$1" '$1 ~ "^[[:space:]]*" key "[[:space:]]*=" { print $2; exit }' "$COLORS"
}
BACKGROUND="$(palette background)"
FOREGROUND="$(palette foreground)"
ACCENT="$(palette accent)"
SELECTION="$(palette selection)"
for color in "$BACKGROUND" "$FOREGROUND" "$ACCENT" "$SELECTION"; do
    [[ "$color" =~ ^#[0-9a-fA-F]{6}$ ]] || { warn "hooks.gtk_palette_failed" "$COLORS"; exit 1; }
done
MODE="$(palette mode)"
[[ "$MODE" == light || "$MODE" == dark ]] || err "hooks.gtk_palette_failed" "$COLORS"
if [[ "$MODE" == light ]]; then
    GTK_BASE_THEME=Materia-light
    GTK_DARK=false
    GTK_ICONS=OS-Qogir
else
    GTK_BASE_THEME=Materia-dark
    GTK_DARK=true
    GTK_ICONS=OS-Qogir
fi
mix_color() {
    local percentage="$1" channel a b
    printf '#'
    for channel in 1 3 5; do
        a=$((16#${BACKGROUND:channel:2}))
        b=$((16#${FOREGROUND:channel:2}))
        printf '%02x' "$(( (a * (100 - percentage) + b * percentage) / 100 ))"
    done
}
SURFACE=$BACKGROUND
HOVER=$(mix_color 10)
MUTED=$(mix_color 55)
template="${XDG_DATA_HOME:-$HOME/.local/share}/os/gtk/palette.css.in"
[[ -r "$template" ]] || template="$SCRIPT_DIR/../../modules/conf/gtk/data/palette.css.in"
[[ -r "$template" ]] || err "hooks.gtk_palette_failed" "$template"
THEME_HASH=$(printf '%s\n' "$BACKGROUND" "$FOREGROUND" "$ACCENT" "$SELECTION" "$MODE" "$(sha256sum "$template")" | sha256sum)
GTK_THEME_NAME="OS-${THEME_HASH:0:16}"
GTK_THEME_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/themes/$GTK_THEME_NAME"
mkdir -p "$GTK_THEME_DIR/gtk-3.0" "$GTK_THEME_DIR/gtk-4.0"

for version in 3 4; do
    config="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-$version.0"
    mkdir -p "$config"
    settings="$(mktemp "$config/.settings.XXXXXX")"
    if [[ -f "$config/settings.ini" ]]; then cat "$config/settings.ini" > "$settings"; fi
    temporary="$(mktemp "$config/.settings-new.XXXXXX")"
    awk -v theme="$GTK_THEME_NAME" -v dark="$GTK_DARK" -v icons="$GTK_ICONS" -v version="$version" '
        function managed() {
            print "gtk-theme-name=" theme
            if (version == 3) print "gtk-application-prefer-dark-theme=" dark
            print "gtk-icon-theme-name=" icons
            print "gtk-cursor-theme-name=capitaine-cursors"
        }
        /^\[Settings\]$/ { in_settings=1; found=1; print; managed(); next }
        /^\[/ { in_settings=0 }
        in_settings && /^gtk-(theme-name|application-prefer-dark-theme|icon-theme-name|cursor-theme-name)=/ { next }
        { print }
        END { if (!found) { print "[Settings]"; managed() } }
    ' "$settings" > "$temporary"
    chmod 644 "$temporary"
    mv -f "$temporary" "$config/settings.ini"
    rm -f "$settings"
    temporary="$(mktemp "$config/.os.XXXXXX")"
    sed -e "s/@BACKGROUND@/$BACKGROUND/g" -e "s/@FOREGROUND@/$FOREGROUND/g" \
        -e "s/@ACCENT@/$ACCENT/g" -e "s/@SELECTION@/$SELECTION/g" -e "s/@SURFACE@/$SURFACE/g" \
        "$template" > "$temporary"
    if [[ "$version" == 4 ]]; then
        cat >> "$temporary" <<EOF_CSS
:root {
  --window-bg-color: $BACKGROUND;
  --window-fg-color: $FOREGROUND;
  --view-bg-color: $BACKGROUND;
  --view-fg-color: $FOREGROUND;
  --headerbar-bg-color: $SURFACE;
  --headerbar-fg-color: $FOREGROUND;
  --sidebar-bg-color: $SURFACE;
  --sidebar-fg-color: $FOREGROUND;
  --card-bg-color: $BACKGROUND;
  --card-fg-color: $FOREGROUND;
  --dialog-bg-color: $BACKGROUND;
  --dialog-fg-color: $FOREGROUND;
  --popover-bg-color: $BACKGROUND;
  --popover-fg-color: $FOREGROUND;
  --accent-bg-color: $ACCENT;
  --accent-fg-color: $BACKGROUND;
  --accent-color: $ACCENT;
  --border-opacity: 0.15;
}
placessidebar .navigation-sidebar { padding: 6px; background-color: $SURFACE; }
placessidebar .navigation-sidebar row { min-height: 28px; margin: 2px 0; padding: 4px 10px; border: none; border-left: 3px solid transparent; background-color: transparent; color: $FOREGROUND; }
placessidebar .navigation-sidebar row:dir(rtl) { border-left: none; border-right: 3px solid transparent; }
placessidebar .navigation-sidebar row:hover { background-color: $HOVER; }
placessidebar .navigation-sidebar row:selected, placessidebar .navigation-sidebar row:selected:hover { background-color: $SELECTION; border-color: $ACCENT; color: $FOREGROUND; }
placessidebar .navigation-sidebar row image { color: $MUTED; }
placessidebar .navigation-sidebar row:selected image { color: $ACCENT; }
placessidebar .navigation-sidebar .sidebar-button { min-width: 20px; min-height: 20px; padding: 2px; border: none; }
placessidebar .navigation-sidebar row:disabled, placessidebar .navigation-sidebar row:disabled image { color: $MUTED; }
EOF_CSS
    fi
    chmod 644 "$temporary"
    mv -f "$temporary" "$config/os.css"
    if [[ "$version" == 3 ]]; then
        if [[ -f "$config/gtk.css" ]]; then
            temporary="$(mktemp "$config/.gtk.XXXXXX")"
            awk '$0 != "@import url(\"os.css\");" { print }' "$config/gtk.css" > "$temporary"
            chmod 644 "$temporary"
            mv -f "$temporary" "$config/gtk.css"
        fi
        printf '@import url("/usr/share/themes/%s/gtk-3.0/gtk.css");\n' "$GTK_BASE_THEME" > "$GTK_THEME_DIR/gtk-3.0/gtk.css"
        cat "$config/os.css" >> "$GTK_THEME_DIR/gtk-3.0/gtk.css"
        cp "$GTK_THEME_DIR/gtk-3.0/gtk.css" "$GTK_THEME_DIR/gtk-3.0/gtk-dark.css"
    else
        cp "$config/os.css" "$GTK_THEME_DIR/gtk-4.0/gtk.css"
        cp "$config/os.css" "$GTK_THEME_DIR/gtk-4.0/gtk-dark.css"
    fi
    if [[ "$version" == 4 ]] && ! grep -qFx '@import url("os.css");' "$config/gtk.css" 2>/dev/null; then
        temporary="$(mktemp "$config/.gtk.XXXXXX")"
        printf '%s\n' '@import url("os.css");' > "$temporary"
        if [[ -f "$config/gtk.css" ]]; then cat "$config/gtk.css" >> "$temporary"; fi
        chmod 644 "$temporary"
        mv -f "$temporary" "$config/gtk.css"
    fi
done
printf '[Desktop Entry]\nName=%s\nType=X-GNOME-Metatheme\n[X-GNOME-Metatheme]\nGtkTheme=%s\nIconTheme=%s\n' "$GTK_THEME_NAME" "$GTK_THEME_NAME" "$GTK_ICONS" > "$GTK_THEME_DIR/index.theme"

if [[ -z "${OS_THEME_COLORS:-}" && -S "${XDG_RUNTIME_DIR:-/nonexistent}/bus" ]]; then
    gsettings set org.gnome.desktop.interface gtk-theme "$GTK_THEME_NAME"
    gsettings set org.gnome.desktop.interface color-scheme "prefer-$MODE"
    gsettings set org.gnome.desktop.interface icon-theme "$GTK_ICONS"
    gsettings set io.github.celluloid-player.Celluloid dark-theme-enable "$GTK_DARK"
fi
