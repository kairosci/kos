#!/usr/bin/env bash

wallpaper_hook() {
    set -euo pipefail
    SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
    OS_I18N_BOOT="$SCRIPT_DIR/../i18n/i18n-boot.sh"
    [[ -f "$OS_I18N_BOOT" ]] || OS_I18N_BOOT="$SCRIPT_DIR/../../scripts/lib/i18n-boot.sh"
    source "$OS_I18N_BOOT"
    local library="${XDG_DATA_HOME:-$HOME/.local/share}/os/desktop/scripts/wallpaper.sh"
    [[ -r "$library" ]] || library="$SCRIPT_DIR/../../modules/conf/desktop/scripts/wallpaper.sh"
    source "$library"
    render_wallpapers "$@"
}

wallpaper_hook "$@"
